{% set canonicalCurrent = (canonicalUrl or (page.url | absoluteUrl)) | canonicalizeUrl %}
{% set siteRootUrl = ("/" | absoluteUrl) | canonicalizeUrl %}
{% set blogIndexUrl = ("/blog/" | absoluteUrl) | canonicalizeUrl %}
{% set aboutUrl = ("/about" | absoluteUrl) | canonicalizeUrl %}
{% set aboutAuthorUrl = (aboutUrl ~ "#author") | canonicalizeUrl %}
{% set heroImageUrl = (heroImage | absoluteUrl) | canonicalizeUrl %}
{% set logoUrl = ("/assets/images/logo.png" | absoluteUrl) | canonicalizeUrl %}
{% set publishedIso = date | isoDate %}
{% set modifiedIso = (dateModified or date) | isoDate %}

<!-- BreadcrumbList Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ siteRootUrl | jsonLd | safe }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": {{ blogIndexUrl | jsonLd | safe }}
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | jsonLd | safe }}
        }
    ]
}
</script>

<!-- Article Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | jsonLd | safe }},
    "description": {{ description | jsonLd | safe }},
    "image": {
        "@type": "ImageObject",
        "url": {{ heroImageUrl | jsonLd | safe }},
        "width": 1200,
        "height": 630
    },
    "author": {
        "@type": "Person",
        "@id": {{ aboutAuthorUrl | jsonLd | safe }},
        "name": {{ author | jsonLd | safe }},
        "url": {{ aboutUrl | jsonLd | safe }},
        "jobTitle": "Real Estate Investor & Educator",
        "knowsAbout": [
            "Airbnb Arbitrage",
            "Real Estate Investing",
            "Short-Term Rentals",
            "Passive Income Strategies",
            "Property Management"
        ],
        "sameAs": [
            "https://www.instagram.com/thelegacyshow",
            "https://www.youtube.com/@thelegacyinvestingshow",
            "https://www.tiktok.com/@thelegacyshow"
        ]
    },
    "publisher": {
        "@type": "Organization",
        "name": "Legacy Investing Show",
        "url": {{ siteRootUrl | jsonLd | safe }},
        "logo": {
            "@type": "ImageObject",
            "url": {{ logoUrl | jsonLd | safe }},
            "width": 512,
            "height": 512
        },
        "sameAs": [
            "https://www.instagram.com/thelegacyshow",
            "https://www.youtube.com/@thelegacyinvestingshow",
            "https://www.tiktok.com/@thelegacyshow",
            "https://www.facebook.com/share/19LQhE6gmh/"
        ]
    },
    "datePublished": {{ publishedIso | jsonLd | safe }},
    "dateModified": {{ modifiedIso | jsonLd | safe }},
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonicalCurrent | jsonLd | safe }}
    },
    "articleSection": {{ category | jsonLd | safe }},
    "wordCount": {{ wordCount | jsonLd | safe }},
    "keywords": {{ keywords | jsonLd | safe }},
    "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".minimal-article-title", ".minimal-content p:first-of-type"]
    },
    "isAccessibleForFree": true,
    "inLanguage": "en-US"
}
</script>

{% if faqs and (faqs | length) > 0 %}
<!-- FAQPage Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {% for faq in faqs %}
        {
            "@type": "Question",
            "name": {{ faq.question | jsonLd | safe }},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq.answer | jsonLd | safe }}
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}

<!-- Organization Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Legacy Investing Show",
    "url": {{ siteRootUrl | jsonLd | safe }},
    "logo": {{ logoUrl | jsonLd | safe }},
    "sameAs": [
        "https://www.instagram.com/thelegacyinvestingshow/",
        "https://www.youtube.com/@LegacyInvestingShow",
        "https://www.tiktok.com/@thelegacyinvestingshow",
        "https://www.facebook.com/share/19LQhE6gmh/"
    ]
}
</script>
