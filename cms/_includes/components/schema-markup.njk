{% set canonicalCurrent = (canonicalUrl or (page.url | absoluteUrl)) | canonicalizeUrl %}
{% set siteRootUrl = ("/" | absoluteUrl) | canonicalizeUrl %}
{% set blogIndexUrl = ("/blog/" | absoluteUrl) | canonicalizeUrl %}
{% set heroImageUrl = ((hero.ogImage or heroImage) | absoluteUrl) | canonicalizeUrl %}
{% set publishedIso = date | isoDate %}
{% set modifiedIso = (dateModified or date) | isoDate %}

<!-- BreadcrumbList Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ siteRootUrl | jsonLd | safe }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": {{ blogIndexUrl | jsonLd | safe }}
        },
        {
            "@type": "ListItem",
            "position": 3,
            "name": {{ title | jsonLd | safe }},
            "item": {{ canonicalCurrent | jsonLd | safe }}
        }
    ]
}
</script>

<!-- Article Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ title | jsonLd | safe }},
    "description": {{ description | jsonLd | safe }},
    "image": {
        "@type": "ImageObject",
        "url": {{ heroImageUrl | jsonLd | safe }},
        "width": 1200,
        "height": 630
    },
    "author": {{ author | authorSchema | jsonLd | safe }},
    "publisher": {{ schemaOrg.organization | jsonLd | safe }},
    "datePublished": {{ publishedIso | jsonLd | safe }},
    "dateModified": {{ modifiedIso | jsonLd | safe }},
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonicalCurrent | jsonLd | safe }}
    },
    "articleSection": {{ (articleCategory or category) | jsonLd | safe }},
    "wordCount": {{ wordCount | jsonLd | safe }},
    "keywords": {{ keywords | jsonLd | safe }},
    "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": [".post-title", ".post-prose > p:first-of-type"]
    },
    "isAccessibleForFree": true,
    "inLanguage": "en-US"
}
</script>

{% if faqs and (faqs | length) > 0 %}
<!-- FAQPage Schema -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {% for faq in faqs %}
        {
            "@type": "Question",
            "name": {{ faq.question | jsonLd | safe }},
            "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq.answer | jsonLd | safe }}
            }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}
</script>
{% endif %}

<!-- Organization Schema -->
<script type="application/ld+json">
{{ schemaOrg.organizationWithContext | jsonLd | safe }}
</script>
