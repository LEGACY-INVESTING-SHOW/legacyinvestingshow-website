<section class="mt-16 bg-white rounded-xl shadow-lg p-8">
    <h2 class="text-3xl font-bold text-navy mb-8">Frequently Asked Questions</h2>
    <div class="space-y-6">
        {% for faq in faqs %}
        <div class="border-b pb-6">
            <h3 class="text-xl font-semibold text-navy mb-3">{{ faq.question }}</h3>
            <p class="text-gray-600">{{ faq.answer }}</p>
        </div>
        {% endfor %}
    </div>
</section>
