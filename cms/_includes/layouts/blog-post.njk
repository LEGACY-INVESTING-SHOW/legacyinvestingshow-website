<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

{%- set seoTitle = title -%}
{%- if "Legacy Investing Show" not in seoTitle -%}
{%- set seoTitle = title ~ " | Legacy Investing Show" -%}
{%- endif -%}
{%- set hero = page.fileSlug | blogHero -%}
{%- set articleCategory = category | blogCategory -%}
    <title>{{ seoTitle }}</title>
    <meta name="title" content="{{ seoTitle }}">
    <meta name="description" content="{{ description }}">
    <meta name="keywords" content="{{ keywords }}">
    <meta name="author" content="{{ author }}">
    <meta name="robots" content="index, follow">
    {% set canonicalCurrent = (canonicalUrl or (page.url | absoluteUrl)) | canonicalizeUrl %}
    <link rel="canonical" href="{{ canonicalCurrent }}">

    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ canonicalCurrent }}">
    <meta property="og:title" content="{{ title }} | Legacy Investing Show">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="{{ hero.ogImage }}">
    <meta property="og:site_name" content="Legacy Investing Show">
    <meta property="article:published_time" content="{{ date | isoDate }}">
    <meta property="article:modified_time" content="{{ (dateModified or date) | isoDate }}">
    <meta property="article:author" content="{{ author }}">
    <meta property="article:section" content="{{ articleCategory }}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@thelegacyshow">
    <meta name="twitter:title" content="{{ title }} | Legacy Investing Show">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ hero.ogImage }}">

    <meta name="theme-color" content="#FAF7F2">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    {% if hero.exists %}{% if hero.webp %}<link rel="preload" as="image" href="{{ hero.webp }}" type="image/webp" fetchpriority="high">{% else %}<link rel="preload" as="image" href="{{ hero.src }}" fetchpriority="high">{% endif %}{% endif %}

    {{ siteShell.headAssets | safe }}
    <link rel="stylesheet" href="/assets/css/blog.css">

    {% include "components/schema-markup.njk" %}

    {{ siteShell.analyticsHead | safe }}
</head>
<body data-page-type="blog_post" data-page-title="{{ title }}">
    {{ siteShell.analyticsBody | safe }}
    <a href="#main" class="skip-link">Skip to main content</a>

    {{ siteShell.header | safe }}

    <main id="main">
        <div class="post-page">
        {{ content | articleBody(page.fileSlug) | safe }}
        </div>
    </main>

    {{ siteShell.footer | safe }}

    <script defer src="/assets/js/main.js"></script>
</body>
</html>
