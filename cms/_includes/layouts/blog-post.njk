<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Primary Meta Tags -->
{%- set seoTitle = title -%}
{%- if "Legacy Investing Show" not in seoTitle -%}
{%- set seoTitle = title ~ " | Legacy Investing Show" -%}
{%- endif %}
    <title>{{ seoTitle }}</title>
    <meta name="title" content="{{ seoTitle }}">
    <meta name="description" content="{{ description }}">
    <meta name="keywords" content="{{ keywords }}">
    <meta name="author" content="{{ author }}">
    <meta name="robots" content="index, follow">
    {% set canonicalCurrent = (canonicalUrl or (page.url | absoluteUrl)) | canonicalizeUrl %}
    <link rel="canonical" href="{{ canonicalCurrent }}">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ canonicalCurrent }}">
    <meta property="og:title" content="{{ title }} | Legacy Investing Show">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="{{ heroImage | absoluteUrl }}">
    <meta property="og:site_name" content="Legacy Investing Show">
    <meta property="article:published_time" content="{{ date | isoDate }}">
    <meta property="article:modified_time" content="{{ (dateModified or date) | isoDate }}">
    <meta property="article:author" content="{{ author }}">
    <meta property="article:section" content="{{ category }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@thelegacyshow">
    <meta name="twitter:title" content="{{ title }} | Legacy Investing Show">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ heroImage | absoluteUrl }}">

    <!-- Theme Color -->
    <meta name="theme-color" content="#FAF7F2">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/images/logo.png">
    <link rel="apple-touch-icon" href="/assets/images/logo.png">

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {% set hasDistinctWebpHero = imageWebp and imageWebp != heroImage %}

    <!-- Preload hero image for LCP -->
    {% if hasDistinctWebpHero %}
    <link rel="preload" as="image" href="{{ imageWebp }}" type="image/webp" fetchpriority="high">
    {% else %}
    <link rel="preload" as="image" href="{{ heroImage }}" fetchpriority="high">
    {% endif %}

    <!-- Stylesheet -->
    <link rel="stylesheet" href="/assets/css/styles.css">
    
    <style>
        .minimal-article {
            margin: 0 auto;
            max-width: 1280px;
            padding: 124px 24px 88px;
        }

        .article-shell {
            display: grid;
            gap: 2rem;
            align-items: start;
        }

        .article-main {
            min-width: 0;
        }

        .article-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            margin-bottom: 1rem;
            padding: 0.45rem 0.85rem;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.04);
            border: 1px solid rgba(201, 169, 97, 0.18);
            color: var(--gold-dark);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .article-eyebrow::before {
            content: "";
            width: 0.45rem;
            height: 0.45rem;
            border-radius: 999px;
            background: var(--gold);
            box-shadow: 0 0 0 6px rgba(201, 169, 97, 0.12);
        }

        .minimal-article-header {
            margin-bottom: 1.8rem;
            text-align: left;
        }

        .minimal-article-meta {
            justify-content: flex-start;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .minimal-article-title {
            max-width: 14ch;
            margin-bottom: 1rem;
            font-size: clamp(2.4rem, 5vw, 4.5rem);
            line-height: 0.98;
            letter-spacing: -0.04em;
        }

        .minimal-article-description {
            max-width: 46rem;
            margin: 0 0 1.15rem;
            color: var(--text-secondary);
            font-size: 1.08rem;
            line-height: 1.8;
        }

        .minimal-article-author {
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.55rem 0.8rem 0.55rem 0.55rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
        }

        .author-avatar {
            width: 2.6rem;
            height: 2.6rem;
            border-radius: 999px;
            object-fit: cover;
            border: 2px solid rgba(201, 169, 97, 0.24);
        }

        .minimal-featured-image {
            margin-bottom: 1.8rem;
            border-radius: 28px;
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 28px 80px rgba(15, 23, 42, 0.12);
        }

        .article-intro-card {
            display: grid;
            gap: 1.5rem;
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
            margin-bottom: 1.8rem;
            padding: 1.6rem 1.75rem;
            border-radius: 28px;
            background:
                radial-gradient(circle at top right, rgba(201, 169, 97, 0.18), transparent 38%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(250, 247, 242, 0.92));
            border: 1px solid rgba(201, 169, 97, 0.22);
            box-shadow: 0 20px 48px rgba(15, 23, 42, 0.08);
        }

        .article-intro-card__eyebrow {
            margin: 0 0 0.6rem;
            color: var(--gold-dark);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .article-intro-card__title {
            margin: 0;
            color: var(--navy);
            font-size: clamp(1.55rem, 2.5vw, 2.15rem);
            line-height: 1.08;
        }

        .article-intro-card__copy {
            margin: 0;
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.78;
        }

        .article-intro-card__list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 0.8rem;
        }

        .article-intro-card__list li {
            position: relative;
            margin: 0;
            padding-left: 1.35rem;
            color: var(--text-primary);
            font-size: 0.96rem;
            line-height: 1.65;
        }

        .article-intro-card__list li::before {
            content: "";
            position: absolute;
            top: 0.58rem;
            left: 0;
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--gold), var(--gold-dark));
        }

        .article-rail {
            display: grid;
            gap: 1rem;
        }

        .statistics-section {
            margin: 0;
        }

        .statistics-grid {
            display: grid;
            gap: 0.9rem;
            grid-template-columns: 1fr;
        }

        .stat-card {
            padding: 1.15rem 1.2rem;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
            text-align: left;
        }

        .stat-icon-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.7rem;
            height: 2.7rem;
            margin-bottom: 0.95rem;
            border-radius: 0.95rem;
            background: rgba(201, 169, 97, 0.12);
            color: var(--gold-dark);
        }

        .stat-icon {
            width: 1.3rem;
            height: 1.3rem;
        }

        .stat-value {
            color: var(--navy);
            font-family: "DM Serif Display", Georgia, serif;
            font-size: 2rem;
            line-height: 1;
            letter-spacing: -0.04em;
        }

        .stat-label {
            margin-top: 0.45rem;
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 700;
            line-height: 1.4;
            text-transform: none;
        }

        .stat-context,
        .stat-source {
            display: block;
            margin-top: 0.65rem;
            color: var(--text-muted);
            font-size: 0.84rem;
            line-height: 1.6;
        }

        .article-rail-card {
            padding: 1.25rem 1.25rem 1.3rem;
            border-radius: 24px;
            background: linear-gradient(160deg, #182234, #0f172a);
            color: white;
            box-shadow: 0 22px 55px rgba(15, 23, 42, 0.18);
        }

        .article-rail-card--muted {
            background: rgba(255, 255, 255, 0.9);
            color: var(--text-secondary);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.06);
        }

        .article-rail-card__eyebrow {
            margin: 0 0 0.55rem;
            color: rgba(217, 196, 138, 0.92);
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .article-rail-card--muted .article-rail-card__eyebrow {
            color: var(--gold-dark);
        }

        .article-rail-card__title {
            margin: 0 0 0.75rem;
            color: inherit;
            font-size: 1.35rem;
            line-height: 1.12;
        }

        .article-rail-card__body {
            margin: 0;
            color: inherit;
            font-size: 0.95rem;
            line-height: 1.72;
        }

        .minimal-content {
            padding: clamp(1.35rem, 2vw, 2.6rem);
            border-radius: 32px;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 28px 72px rgba(15, 23, 42, 0.08);
            color: #374151;
            font-size: 1.07rem;
            line-height: 1.8;
        }

        .minimal-content p {
            margin-bottom: 1.45rem;
            line-height: 1.82;
        }

        .minimal-content h2 {
            margin-top: 3rem;
            margin-bottom: 1.2rem;
            color: #111827;
            font-size: clamp(1.9rem, 2.8vw, 2.6rem);
            font-weight: 400;
            line-height: 1.08;
        }

        .minimal-content h3 {
            margin-top: 2.2rem;
            margin-bottom: 0.95rem;
            font-size: 1.35rem;
            font-weight: 700;
            color: #1f2937;
            line-height: 1.3;
        }

        .minimal-content table {
            width: 100%;
            margin: 2.2rem 0;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.97rem;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
        }

        .minimal-content thead {
            background: #0f172a;
            color: white;
        }

        .minimal-content th {
            padding: 1rem 1.1rem;
            text-align: left;
            font-weight: 700;
            font-size: 0.77rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .minimal-content td {
            padding: 0.95rem 1.1rem;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }

        .minimal-content tbody tr:last-child td {
            border-bottom: none;
        }

        .minimal-content tbody tr:nth-child(even) {
            background: #faf7f2;
        }

        .minimal-content tbody tr:hover {
            background: rgba(201, 169, 97, 0.09);
        }

        .minimal-content blockquote {
            margin: 2.3rem 0;
            padding: 1.4rem 1.6rem;
            border-radius: 24px;
            background: rgba(201, 169, 97, 0.11);
            border-left: 4px solid #d4a853;
            font-size: 1.12rem;
            line-height: 1.72;
        }

        .minimal-content blockquote p {
            margin-bottom: 0;
        }

        .minimal-content ul,
        .minimal-content ol {
            margin-bottom: 1.45rem;
            padding-left: 1.35rem;
        }

        .minimal-content li {
            margin-bottom: 0.7rem;
            line-height: 1.72;
        }

        .minimal-content strong {
            font-weight: 700;
            color: #111827;
        }

        .minimal-content a {
            color: #b8933f;
            text-decoration: underline;
            text-decoration-thickness: 1px;
            text-underline-offset: 0.16em;
        }

        .minimal-content a:hover {
            color: #8e6d2d;
        }

        .article-faq {
            margin-top: 2rem;
            padding: 1.5rem;
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid rgba(15, 23, 42, 0.08);
            box-shadow: 0 22px 55px rgba(15, 23, 42, 0.08);
        }

        .article-faq__header {
            margin-bottom: 1rem;
        }

        .article-faq__eyebrow {
            margin: 0 0 0.45rem;
            color: var(--gold-dark);
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .article-faq__title {
            margin: 0;
            color: var(--navy);
            font-size: clamp(1.7rem, 2.2vw, 2.25rem);
        }

        .article-faq__list {
            display: grid;
            gap: 0.85rem;
        }

        .article-faq__item {
            border-radius: 20px;
            border: 1px solid rgba(15, 23, 42, 0.08);
            background: rgba(250, 247, 242, 0.65);
            overflow: hidden;
        }

        .article-faq__question {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.1rem 1.15rem;
            border: none;
            background: transparent;
            color: var(--navy);
            font-size: 0.98rem;
            font-weight: 700;
            text-align: left;
        }

        .article-faq__chevron {
            width: 1.15rem;
            height: 1.15rem;
            color: var(--text-muted);
            transition: transform 0.2s ease;
            flex: 0 0 auto;
        }

        .article-faq__question[aria-expanded="true"] .article-faq__chevron {
            transform: rotate(180deg);
        }

        .article-faq__answer {
            display: none;
            padding: 0 1.15rem 1.15rem;
        }

        .article-faq__answer--open {
            display: block;
        }

        .article-faq__answer p {
            margin: 0;
            color: var(--text-secondary);
            font-size: 0.97rem;
            line-height: 1.72;
        }

        @media (min-width: 1024px) {
            .article-shell {
                grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.78fr);
                gap: 2.25rem;
            }

            .article-rail {
                position: sticky;
                top: 6.5rem;
            }
        }

        @media (max-width: 1023px) {
            .article-shell {
                gap: 1.5rem;
            }

            .statistics-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 767px) {
            .minimal-article {
                padding: 106px 18px 64px;
            }

            .minimal-article-title {
                max-width: none;
                font-size: clamp(2rem, 10vw, 3rem);
            }

            .minimal-article-description {
                font-size: 1rem;
            }

            .article-intro-card {
                grid-template-columns: 1fr;
                padding: 1.25rem;
                border-radius: 24px;
            }

            .minimal-featured-image,
            .minimal-content,
            .article-faq {
                border-radius: 24px;
            }

            .minimal-content {
                padding: 1.15rem;
            }

            .minimal-content h2 {
                margin-top: 2.35rem;
            }

            .minimal-content table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
                -webkit-overflow-scrolling: touch;
            }
        }

        @media (max-width: 479px) {
            .statistics-grid {
                grid-template-columns: 1fr;
            }

            .article-rail-card,
            .stat-card {
                padding: 1rem;
            }
        }
    </style>

    <!-- Schema Markup -->
    {% include "components/schema-markup.njk" %}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2578PT1WSS"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-2578PT1WSS');
    </script>
</head>
<body class="bg-cream text-navy">
    <a href="#main" class="skip-link">Skip to main content</a>

    {% include "components/header.njk" %}

    <!-- Reading Progress Bar -->
    <div class="reading-progress" aria-hidden="true">
        <div class="reading-progress-bar"></div>
    </div>

    <main id="main">
        <article class="minimal-article">
            {% include "components/breadcrumb.njk" %}

            <div class="article-shell">
                <div class="article-main">
                    <header class="minimal-article-header">
                        <span class="article-eyebrow">{{ pageLabel }}</span>
                        <div class="minimal-article-meta">
                            <span>{{ category }}</span>
                            <span class="meta-dot"></span>
                            <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
                            <span class="meta-dot"></span>
                            <span>{{ readTime }} min read</span>
                        </div>
                        <h1 class="minimal-article-title">{{ title }}</h1>
                        <p class="minimal-article-description">{{ description }}</p>
                        <div class="minimal-article-author">
                            <picture>
                                <source srcset="/assets/images/preston-main.webp" type="image/webp">
                                <img src="/assets/images/preston-main.jpg"
                                     alt="{{ author }}"
                                     width="36"
                                     height="36"
                                     class="author-avatar"
                                     fetchpriority="low"
                                     decoding="async">
                            </picture>
                            <span>{{ author }}</span>
                        </div>
                    </header>

                    <div class="minimal-featured-image">
                        <picture>
                            {% if hasDistinctWebpHero %}
                            <source srcset="{{ imageWebp }}" type="image/webp">
                            {% endif %}
                            <img src="{{ heroImage }}" alt="{{ imageAlt or title }}" width="800" height="450" loading="eager" fetchpriority="high" decoding="async">
                        </picture>
                    </div>

                    <section class="article-intro-card" aria-label="How to use this guide">
                        <div>
                            <p class="article-intro-card__eyebrow">Use This Like a Tool</p>
                            <h2 class="article-intro-card__title">{{ guideIntro }}</h2>
                        </div>
                        <ul class="article-intro-card__list">
                            {% for item in guideChecklist %}
                            <li>{{ item }}</li>
                            {% endfor %}
                        </ul>
                    </section>

                    <div class="minimal-content">
                        {{ content | safe }}
                    </div>

                    {% sourceBlock title, page.fileSlug, category %}

                    {% if faqs and (faqs | length) > 0 %}
                        {% include "components/faq-section.njk" %}
                    {% endif %}
                </div>

                <aside class="article-rail">
                    {% if stats and (stats | length) > 0 %}
                        {% include "components/stat-cards.njk" %}
                    {% endif %}
                    <div class="article-rail-card">
                        <p class="article-rail-card__eyebrow">Before You Act</p>
                        <h2 class="article-rail-card__title">{{ railNoteTitle }}</h2>
                        <p class="article-rail-card__body">{{ railNoteBody }}</p>
                    </div>
                    <div class="article-rail-card article-rail-card--muted">
                        <p class="article-rail-card__eyebrow">Important</p>
                        <p class="article-rail-card__body">Educational only. Results vary. Tax, legal, and investment decisions should be reviewed with a qualified professional who can see your full situation.</p>
                    </div>
                </aside>
            </div>
        </article>
    </main>

    {% include "components/footer.njk" %}

    <script src="/assets/js/main.js"></script>
</body>
</html>
