# Legacy Investing Show Environment Variables
# Copy this file to .env and fill in your values

# Site URL (used for sitemap and RSS generation)
SITE_URL=https://legacyinvestingshow.com

# Google Analytics Tracking ID
GA_TRACKING_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
GTM_CONTAINER_ID=GTM-XXXXXXX

# Optional: Google Search Console verification
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Optional: Bing Webmaster verification
# BING_SITE_VERIFICATION=your-verification-code

# BlogEO / Search Console
# Use the URL-prefix property that matches production canonicals.
GSC_PROPERTY=https://www.legacyinvestingshow.com/
BLOGEO_INTERFACE=github
BLOGEO_ALLOW_DIRECT_PUBLISH=0

# Search Console API (not wired yet; CSV ingest is the v0 path)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# GA4 Data API (optional AEO click measurement; not wired yet)
# GA4_PROPERTY_ID=properties/123456789
