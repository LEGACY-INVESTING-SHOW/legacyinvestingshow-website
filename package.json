{
  "name": "legacy-investing-show",
  "version": "1.0.0",
  "description": "Legacy Investing Show - Build Wealth That Lasts Beyond A Paycheck",
  "scripts": {
    "dev": "npx tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --watch",
    "lint": "node --check scripts/generate-seo-blog-markdown.js && node --check tests/generate-seo-blog-markdown.test.js",
    "test": "node --test tests/*.test.js",
    "batch:opencode:example": "node scripts/run-opencode-blog-batch.js --write-example",
    "batch:opencode": "node scripts/run-opencode-blog-batch.js",
    "build:css": "NODE_ENV=production npx tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --minify",
    "build:blog": "node scripts/build-blog.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:video-sitemap": "node scripts/generate-video-sitemap.js",
    "build:rss": "node scripts/generate-rss.js",
    "build:images": "node scripts/optimize-images.js",
    "build:assets": "node scripts/version-assets.js",
    "build:tax-strategies": "node scripts/build-tax-strategies.js && node scripts/sweep-frozen-guides.js",
    "build:compare": "node scripts/build-compare-pages.js",
    "build:topics": "node scripts/build-topic-hubs.js",
    "build:tools": "node scripts/import-calculators.js && node scripts/build-tax-structure-calculator.js && node scripts/build-operator-calculators.js && node scripts/restyle-tools.js",
    "build:shell": "node scripts/sync-static-shell.js",
    "build:reviews": "node scripts/build-reviews-sections.js",
    "build:reviews-schema": "node scripts/build-reviews-schema.js",
    "build:reviews-text": "node scripts/build-reviews-text.js",
    "build:tracking": "node scripts/ensure-tracking-and-verification.js",
    "build:seo-titles": "node scripts/normalize-seo-titles.js",
    "build:links": "node scripts/normalize-internal-redirect-links.js",
    "build:indexation": "node scripts/apply-indexation-policy.js",
    "pipeline:legacy": "node scripts/pipeline/run-pipeline.js",
    "pipeline": "node scripts/pipeline/run-skill-pipeline.js",
    "cms:sync:blog": "bash ./scripts/cms/sync-blog-content.sh",
    "cms:check:parity": "bash ./scripts/cms/check-parity.sh",
    "cms:build": "rm -rf ./cms/_site/blog && npm --prefix ./cms run build",
    "cms:smoke": "bash ./scripts/cms/smoke-check-eleventy.sh",
    "cms:publish:posts": "bash ./scripts/cms/publish-eleventy-posts.sh",
    "cms:verify": "npm run cms:sync:blog && npm run cms:check:parity && npm run cms:build && npm run cms:smoke",
    "build": "npm run build:images && npm run build:css && npm run build:blog && npm run build:tax-strategies && npm run build:compare && npm run build:topics && npm run build:tools && npm run build:lwb && npm run build:shell && npm run build:reviews && npm run build:reviews-schema && npm run build:reviews-text && npm run build:tracking && npm run build:seo-titles && npm run build:links && npm run build:indexation && npm run build:sitemap && npm run build:video-sitemap && npm run build:rss && npm run build:assets",
    "start": "npx serve .",
    "build:lwb": "node scripts/build-lwb-page.js",
    "build:tax-structure": "node scripts/build-tax-structure-calculator.js",
    "build:operator-calculators": "node scripts/build-operator-calculators.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "cssnano": "^7.1.2",
    "postcss": "^8.5.6",
    "serve": "^14.2.0",
    "tailwindcss": "^3.4.19"
  },
  "keywords": [
    "investing",
    "wealth-building",
    "airbnb-arbitrage",
    "financial-education"
  ],
  "author": "Legacy Investing Show",
  "license": "UNLICENSED",
  "private": true
}
